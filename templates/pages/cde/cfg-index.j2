{% extends 'base.j2' %}
{% from 'components/settings/setting-card.j2' import setting_card %}

{% block title %}Ajustes{% endblock title %}

{% block content %}

    <div class="titles-ruler">
        {% from 'components/title-route.j2' import title_container %}
        {{ title_container(
            id_page=session['id_page'],
            breadcrumbs=[
                {'text': 'AJUSTES'}
            ],
            aux_buttons=[
                {'type': 'link', 'url': 'cde_cfg', 'icon': 'svg/cog.svg', 'title': 'AJUSTES'},
                {'type': 'link', 'url': 'cde_profile', 'icon': 'svg/circle-user.svg', 'title': 'PERFIL'},
                {'type': 'divider'},
                {'type': 'link', 'url': 'about', 'icon': 'svg/circle-help.svg', 'title': 'AJUDA'},
                {'type': 'divider'},
                {'type': 'action', 'icon': 'svg/circle-arrow-left.svg', 'title': 'VOLTAR', 'onclick': 'goBack()'}
            ]
        ) }}
    </div>

    <div id="divContent" class="settings-page">
        {% include "components/advert.j2" %}
        {% if 'user_grant' in session %}
            <section class="settings-overview">
                <div>
                    <p class="settings-kicker">CENTRAL DE CONTROLE</p>
                    <h1>Ajustes do sistema</h1>
                    <p>Administre dados, acessos e ferramentas internas em um único lugar.</p>
                </div>
                <div class="settings-overview-mark" aria-label="Versão atual do CDE">
                    <span class="settings-overview-icon">
                        <img src="{{ url_for('static', filename='svg/cog.svg') }}" alt="">
                    </span>
                    <span>
                        <small>AMBIENTE CDE</small>
                        <strong>v{{ app_version[0] }} (beta)</strong>
                    </span>
                </div>
            </section>

            <section class="settings-group" aria-labelledby="settings-system-title">
                <header class="settings-group-header">
                    <div>
                        <p class="settings-kicker">SISTEMA E ACESSO</p>
                        <h2 id="settings-system-title">Configurações principais</h2>
                    </div>
                    <p>Ferramentas de operação e administração.</p>
                </header>
                <div class="settings-grid">
                    {{ setting_card('api', 'Database', 'Faça consultas no banco de dados.', 'svg/database-zap.svg', 'DADOS') }}
                    {{ setting_card('cde_notifications', 'Notificações', 'Consulte mensagens e avisos do sistema.', 'svg/bell.svg', 'PESSOAL') }}
                    {{ setting_card('cde_query_list', 'Queries', 'Visualize a biblioteca de consultas.', 'svg/file-text.svg', 'DADOS') }}
                    {{ setting_card('users', 'Usuários', 'Gerencie usuários e permissões.', 'svg/user-gear.svg', 'ACESSO') }}
                </div>
            </section>

            <section class="settings-group settings-group-advanced" aria-labelledby="settings-dev-title">
                <header class="settings-group-header">
                    <div>
                        <p class="settings-kicker">FERRAMENTAS AVANÇADAS</p>
                        <h2 id="settings-dev-title">Desenvolvimento e manutenção</h2>
                    </div>
                    <span class="settings-warning-badge">USO RESTRITO</span>
                </header>
                <div class="settings-grid settings-grid-compact">
                    {{ setting_card('permissions', 'Contratos', 'Gerencie os identificadores das páginas.', 'svg/cog.svg', 'DEV') }}
                    {{ setting_card('admin_migrations', 'Migrations', 'Acompanhe e execute migrações do sistema.', 'svg/database.svg', 'DEV') }}
                </div>
            </section>
        {% endif %}
    </div>

{% endblock content %}
