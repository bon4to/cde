{% extends 'base.j2' %}
{% from 'components/icon.j2' import icon as ui_icon %}

{% block title %}Etiquetas{% endblock title %}

{% block content %}

    <div class="titles-ruler">

        {% from 'components/title-route.j2' import title_container %}
        {{ title_container(
            id_page=session['id_page'],
            breadcrumbs=[
                {'text': 'OUTROS', 'url': 'home', 'title': 'OUTROS'},
                {'text': 'ETIQUETA'}
            ],
            aux_buttons=[
                {'type': 'link', 'url': 'supply_losses', 'icon': 'svg/wine-off.svg', 'title': 'PERDAS'},
                {'type': 'link', 'url': 'etiqueta', 'icon': 'svg/sticky-note.svg', 'title': 'ETIQUETA', 'active': True},
                {'type': 'link', 'url': 'rotulo', 'icon': 'svg/roll.svg', 'title': 'RÓTULO'},
                {'type': 'divider'},
                {'type': 'action', 'icon': 'svg/circle-arrow-left.svg', 'title': 'VOLTAR', 'onclick': 'goBack()'}
            ]
        ) }}

    </div>
    
    <div id="divContent" class="label-generator-page">
        <section class="label-generator-shell">
            <header class="label-generator-header">
                <div>
                    <p class="label-generator-kicker">IDENTIFICAÇÃO OPERACIONAL</p>
                    <h1>Gerador de etiquetas</h1>
                </div>
                <p>Localize o item, confirme o lote e gere o QR Code para impressão.</p>
            </header>

            <div class="label-generator-layout">
                <div class="label-generator-controls">
                    <section class="label-generator-step">
                        <div class="label-generator-step-heading">
                            <span>01</span>
                            <div>
                                <h2>Localizar item</h2>
                                <p>Leia o código ou informe-o manualmente.</p>
                            </div>
                        </div>
                        <form id="formBuscarItens" class="label-generator-search" method="post" onsubmit="showLockLabel()">
                            <label for="input_code">QR Code ou código de barras</label>
                            <div class="inputs">
                                <input class="address-one" type="text" id="input_code" maxlength="14" name="input_code" required placeholder="Escaneie ou digite o código">
                                <button class="btn-fancy-sober icon-button scanner-submit" type="submit" aria-label="Buscar código" title="Buscar código">
                                    {{ ui_icon('svg/scan-barcode.svg', class_name='ui-icon-md') }}
                                </button>
                            </div>
                        </form>
                    </section>

                    <section class="label-generator-step label-generator-data-step">
                        <div class="label-generator-step-heading">
                            <span>02</span>
                            <div>
                                <h2>Confirmar dados</h2>
                                <p>Revise produto, código e lote.</p>
                            </div>
                        </div>
                        <form id="form-field" class="label-generator-form" method="post" action="{{ url_for('etiqueta') }}">
                            {% from 'components/lock-label.j2' import lock_label %}
                            <div class="label-generator-field label-generator-field-wide">
                                {{ lock_label('Produto', 'desc_item') }}
                                <input id="desc_item" name="desc_item" class="address-one" type="text" value="{{ json_desc_item }}" onclick="maximizeText(this)" required readonly placeholder="Produto selecionado">
                            </div>

                            <div class="label-generator-form-grid">
                                <div class="label-generator-field">
                                    {{ lock_label('Código', 'cod_item', '<span style="color: var(--ux-danger)" id="json_cod_item_ocurr"></span>' | safe) }}
                                    <select id="cod_item" name="cod_item" class="address-two" required onchange="showLockLabel()"></select>
                                </div>
                                <div class="label-generator-field">
                                    {{ lock_label('Lote', 'cod_lote') }}
                                    <input id="lote_item" name="cod_lote" class="address-two" pattern="[A-Z0-9]{6}" maxlength="6" type="text" value="{{ json_cod_lote }}" required readonly placeholder="Lote">
                                </div>
                            </div>

                            <div class="label-generator-actions">
                                <input class="btn-fancy label-generator-submit" type="submit" value="GERAR ETIQUETA">
                                <button class="btn-fancy label-generator-download" aria-label="Gerar e baixar etiqueta" title="Gerar e baixar etiqueta" onclick="toggleCheckbox('imgCheckbox','imgDownload')">
                                    {{ ui_icon('svg/download.svg', class_name='ui-icon-md', element_id='imgCheckbox') }}
                                </button>
                            </div>

                            <input class="check_box" style="display: none" type="checkbox" id="imgDownload" name="imgDownload">
                        </form>
                    </section>
                </div>

                <div class="label-generator-output">
                    <section class="label-generator-current">
                        <div class="label-generator-output-heading">
                            <div>
                                <p class="label-generator-kicker">ETIQUETA ATUAL</p>
                                <h2>Pré-visualização</h2>
                            </div>
                            <span>QR CODE</span>
                        </div>
                        <div class="qr-item featured label-generator-featured">
                            <img id="qrCodeImage" title="Última etiqueta gerada" src="" alt="Última etiqueta gerada">
                        </div>
                        <div id="label-success" class="label-generator-status">Aguardando dados...</div>
                    </section>

                    <section id="tables-container" class="label-generator-history">
                        <div class="label-generator-history-heading">
                            <div>
                                <p class="label-generator-kicker">HISTÓRICO DA SESSÃO</p>
                                <h2>Etiquetas recentes</h2>
                            </div>
                            <span>8 ITENS</span>
                        </div>
                        <div id="qr-grid" class="qr-grid">
                            <div class="qr-item"><img id="qrCodeImage2" src="" alt="Etiqueta recente 1"></div>
                            <div class="qr-item"><img id="qrCodeImage3" src="" alt="Etiqueta recente 2"></div>
                            <div class="qr-item"><img id="qrCodeImage4" src="" alt="Etiqueta recente 3"></div>
                            <div class="qr-item"><img id="qrCodeImage5" src="" alt="Etiqueta recente 4"></div>
                            <div class="qr-item"><img id="qrCodeImage6" src="" alt="Etiqueta recente 5"></div>
                            <div class="qr-item"><img id="qrCodeImage7" src="" alt="Etiqueta recente 6"></div>
                            <div class="qr-item"><img id="qrCodeImage8" src="" alt="Etiqueta recente 7"></div>
                            <div class="qr-item"><img id="qrCodeImage9" src="" alt="Etiqueta recente 8"></div>
                        </div>
                    </section>
                </div>
            </div>
        </section>
    </div>

{% endblock content %}

{% block route_script %}

    <script>

            let ultimoCodigo = '';
            let qrHistory = [];

            function isDuplicateQRCode(qr_text) {
                return qrHistory.some(item => item.text === qr_text);
            }

            function addToQRHistory(qr_text, src) {
                // Remove existing QR code with same text if it exists
                qrHistory = qrHistory.filter(item => item.text !== qr_text);
                
                // Add new QR code to the beginning
                qrHistory.unshift({
                    src: src,
                    text: qr_text
                });
                
                // Keep only the last 9 QR codes
                if (qrHistory.length > 9) {
                    qrHistory.pop();
                }
            }

            function moveToFeatured(index) {
                if (index > 0 && index < qrHistory.length) {
                    // Get the QR code at the clicked position
                    const qrCode = qrHistory[index];
                    
                    // Remove it from its current position
                    qrHistory.splice(index, 1);
                    
                    // Add it to the beginning
                    qrHistory.unshift(qrCode);
                    
                    // Update all images
                    updateQRImages();
                }
            }

            function updateQRImages() {
                // Update featured QR code (current)
                $("#qrCodeImage").attr("src", qrHistory[0].src);
                
                // Update grid QR codes (previous)
                for (let i = 1; i < 9; i++) {
                    if (qrHistory[i]) {
                        $(`#qrCodeImage${i+1}`).attr("src", qrHistory[i].src);
                    } else {
                        $(`#qrCodeImage${i+1}`).attr("src", "");
                    }
                }
            }

            $(function() {
                // Add click handlers to historical QR codes
                for (let i = 1; i <= 8; i++) {
                    $(`#qrCodeImage${i+1}`).click(function() {
                        moveToFeatured(i);
                    });
                }

                $("#formBuscarItens").submit(function(event) {
                    event.preventDefault();
                    var codigo = $("#input_code").val();
                    buscarItens(codigo);
                    $("#input_code").val('');
                });
            });

            $("#cod_item").change(function(event) {
                event.preventDefault();
                var codigo = $("#cod_item").val();
                buscarItens(codigo);
                $("#input_code").val(ultimoCodigo);
            });

            function buscarItens(codigo) {
                $.ajax({
                    type: "POST",
                    url: "/get/item",
                    data: { input_code: codigo },
                    success: function(response) {
                        $("#desc_item").val(response.json_desc_item);
                        $("#cod_item").empty();
                        if (response.json_cod_item_ocurr) {
                            $("#json_cod_item_ocurr").text('( ' + response.json_cod_item_ocurr + ' )');
                        } else {
                            $("#json_cod_item_ocurr").text('');
                        }

                        if (response.json_cod_item.length > 1) {
                            hideLockLabel("label-cod_item");
                            ultimoCodigo = codigo
                        }

                        if (response.json_cod_item) {
                            response.json_cod_item.forEach(function(item) {
                                $("#cod_item").append("<option value='" + item + "'>" + item + "</option>");
                            });
                        } else {
                            $("#cod_item").append("<option value=''></option>");
                        }
                        $("#lote_item").val(response.json_cod_lote);
                        
                        if (response.json_cod_lote === "") {
                            hideLockLabel("label-cod_lote")
                            $("#lote_item").prop("readonly", false);
                        } else {
                            $("#lote_item").prop("readonly", true);
                        }
                    },
                    error: function(error) {
                        console.error("Erro ao buscar itens:", error);
                    }
                });
            }

            document.getElementById("form-field").addEventListener("submit", function() {
                document.getElementById("submitform").disabled = true;
            });

                $("#form-field").submit(function(event) {
                    event.preventDefault();

                    var qr_text = $("#cod_item").val() + ";" + $("#lote_item").val();
                    var desc_item = $("#desc_item").val();
                    var cod_item = $("#cod_item").val();
                    var lote_item = $("#lote_item").val();
                    var check = $("#imgDownload").prop('checked');

                    exibirQRCode(qr_text, desc_item, lote_item, cod_item, check);

                });

                function exibirQRCode(qr_text, desc_item, lote_item, cod_item, check) {
                    $.ajax({
                        type: "POST",
                        url: "/etiqueta",
                        data: { qr_text: qr_text, desc_item: desc_item, lote_item: lote_item, cod_item: cod_item, check: check },
                        success: function(response) {
                            var labelStatus = document.getElementById("label-success");
                            
                            // Add to history with duplicate check
                            addToQRHistory(qr_text, "data:image/img;base64," + response);
                            
                            // Update all images
                            updateQRImages();

                            if (check === false) {
                                $("#qrCodeImage").attr("src", "data:image/img;base64," + response);
                                
                            }
                            else {
                                $("#qrCodeImage").attr("src", "data:image/img;base64," + response);

                                var link = document.createElement('a');
                                link.href = "data:image/img;base64," + response;
                                link.download = qr_text + ".png";
                                document.body.appendChild(link);
                                link.click();
                                document.body.removeChild(link);
                            }
                            labelStatus.innerHTML = '<div class="msg-success" style="width: 100%;">Etiqueta gerada com sucesso!</div>';
                        },
                        error: function(error) {
                            var labelStatus = document.getElementById("label-success");

                            labelStatus.innerHTML = '<div class="msg-error" style="width: 100%;">A etiqueta não pôde ser gerada!</div>';

                            console.error("Erro ao exibir QR Code:", error);
                        }
                    });
                }

    </script>

{% endblock route_script %}
