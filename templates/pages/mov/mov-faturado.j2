{% extends 'base.j2' %}

{% block title %}Faturado{% endblock title %}

{% block content %}

    <div class="titles-ruler">
        
        {% from 'components/title-route.j2' import title_container %}
        {{ title_container(
            id_page=session['id_page'],
            breadcrumbs=[
                {'text': 'LOGI', 'url': 'home_logi', 'title': 'LOGISTICA'},
                {'text': 'CARGAS', 'url': 'home_logi', 'title': 'CARGAS'},
                {'text': 'FATURADAS'}
            ],
            aux_buttons=[
                {'type': 'link', 'url': 'carga_incomp', 'icon': 'svg/package-badge.svg', 'title': 'INCOMPLETAS'},
                {'type': 'link', 'url': 'cargas_baixas', 'icon': 'svg/package-minus.svg', 'title': 'BAIXAS'},
                {'type': 'link', 'url': 'faturado', 'icon': 'svg/package-check.svg', 'title': 'FATURADOS', 'active': True},
                {'type': 'link', 'url': 'cargas', 'icon': 'svg/truck.svg', 'title': 'CARGAS'},
                {'type': 'divider'},
                {'type': 'link', 'url': 'carga_sep_done', 'param_name': 'id_carga', 'param': '0', 'icon': 'svg/grid-2x2.svg', 'title': 'SEPARACAO (CONCLUIDOS)'},
                {'type': 'divider'},
                {'type': 'action', 'icon': 'svg/filter.svg', 'title': 'FILTROS', 'onclick': 'toggleFilter()'},
                {'type': 'action', 'icon': 'svg/circle-arrow-left.svg', 'title': 'VOLTAR', 'onclick': 'goBack()'}
            ]
        ) }}

        {% from 'components/filter-container.j2' import filter_container %}
        {{ filter_container(
            filter_options=[
                {'value': 'cod_item', 'text': 'Item (Código)'},
                {'value': 'desc_item', 'text': 'Item (Descrição)'},
                {'value': 'address', 'text': 'Endereço'},
                {'value': 'cod_lote', 'text': 'Lote (Código)'},
                {'value': 'saldo', 'text': 'Quantidade'},
                {'value': 'time_mov', 'text': 'Data/Hora'},
                {'value': 'id_carga', 'text': 'Carga (Código)'},
                {'value': 'id_req', 'text': 'Requisição (Código)'}
            ],
            button_icon="search.svg",
            form_endpoint="/logi/mov/faturado/search",
            type="form"
        ) }}

    </div>

    <div id="divContent">
        <div class="tables-container" id="tables-container">
            <div style="justify-content: flex-end">
                {% if search_term %}
                    <div class="split-h">
                        <h1 style="font-size: 22px">Critério de pesquisa: <span class="text-main-color">"{{ search_term }}"</span> em <span class="text-main-color">{{ search_row_text }}</span>.</h1>
                        <a class="button-mini btn-fancy" style="margin: 0" onclick="window.location.href='{{ url_for('faturado') }}';" title="Limpar">
                            <img class="svg-invert" src="{{ url_for('static', filename='svg/eraser.svg') }}" alt="">
                        </a>
                    </div>
                {% endif %}
            </div>
            <div class="table-overflow">
                <table id="filterTable">
                    <tr>
                        <th>Endereço</th>
                        <th>Item (Código)</th>
                        <th>Item (Descrição)</th>
                        <th>Lote (Código)</th>
                        <th style="max-width: 50px;">Qtde.</th>
                        <th>Data/Hora</th>
                        <th style="max-width: 50px;">Carga (Código)</th>
                        <th style="max-width: 50px;">Requisição (Código)</th>
                    </tr>
                    {% if inv_data %}
                        {% for item in inv_data %}
                        <tr>
                            <td>{{ item['address'] }}</td>
                            <td>{{ item['cod_item'] }}</td>
                            <td>{{ item['desc_item'] }}</td>
                            <td>{{ item['cod_lote'] }}</td>
                            <td style="text-align: right">{{ item['saldo'] }}</td>
                            <td>{{ item['time_mov'] }}</td>
                            <td>{{ item['id_carga'] }} </td>
                            <td>{{ item['id_req'] }} </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td class="c" colspan="8">Nenhum resultado encontrado.</td>
                        </tr>
                    {% endif %}
                </table>
            </div>
            <div class="pagination">
                {% if page > 1 %}
                <a href="{{ url_for('faturado', page=page-1) }}">&laquo; Anterior</a>
                {% endif %}

                {% if page > 3 %}
                <a href="{{ url_for('faturado', page=1) }}">1</a>
                <span>...</span>
                {% endif %}

                {% for p in range(max(1, page-2), min(total_pages+1, page+3)) %}
                    <a href="{{ url_for('faturado', page=p) }}" class="{% if p == page %}active{% endif %}">{{ p }}</a>
                {% endfor %}

                {% if page < total_pages - 2 %}
                <span>...</span>
                <a href="{{ url_for('faturado', page=total_pages) }}">{{ total_pages }}</a>
                {% endif %}

                {% if page < total_pages %}
                <a href="{{ url_for('faturado', page=page+1) }}">Próximo &raquo;</a>
                {% endif %}
            </div>
            {% if row_count %}
                <p>{{ row_count }} registros |<a style="font-size: unset; margin-left: 5px" href="{{ url_for('export_csv_type', type='faturado') }}">Exportar (CSV)</a></p>
            {% endif %}
        </div>
    </div>

{% endblock content %}
