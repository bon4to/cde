{% extends 'base.j2' %}

{% block title %}Login{% endblock title %}
{% block body_class %}login-shell{% endblock body_class %}

{% block content %}
    <div id="divContent" class="login-page">
        <div class="login-layout">
            <section class="login-brand-panel" aria-label="Centralized Data Engine">
                <div class="login-brand-mark">
                    <img src="{{ url_for('static', filename='img/cde-logo-w.png') }}" alt="CDE">
                </div>

                <div class="login-brand-copy">
                    <h1>Operação centralizada.<br>Trabalho claro.</h1>
                    <p>Sua operação conectada, do estoque à expedição.</p>
                </div>

                <p class="login-brand-footer">CDE · Centralized Data Engine · v{{ app_version[0] }} (beta)</p>
            </section>

            <section class="login-form-panel">
                {% if 'logged_in' not in session %}
                    <div class="login-form-content">


                        <div class="login-intro">
                            <p class="login-eyebrow">ACESSO OPERACIONAL</p>
                            <h1>Bem-vindo de volta.</h1>
                            <p>Entre com suas credenciais para continuar.</p>
                        </div>

                        <form id="form-field" action="/login" method="post" onsubmit="showLoading()">
                            <div class="login-fields">
                                <div class="login-field">
                                    <label for="login_user">Usuário <span aria-hidden="true">*</span></label>
                                    <input type="text" id="login_user" name="login_user" placeholder="usuário / seu@email.com" autocomplete="username" required>
                                </div>

                                <div class="login-field">
                                    <label for="password_user">Senha <span aria-hidden="true">*</span></label>
                                    <input type="password" id="password_user" name="password_user" placeholder="Sua senha" autocomplete="current-password" required>
                                </div>

                                <div class="login-feedback">
                                    <p class="alert" id="custom-alert">{% if alert_msge %}{{ alert_msge }}{% else %}Sua sessão expirou, entre novamente!{% endif %}</p>
                                </div>

                                <button class="btn-fancy login-submit" type="submit" id="submitform">
                                    <span>Entrar</span>
                                    <img class="svg-inv" src="{{ url_for('static', filename='svg/arrow-right.svg') }}" alt="">
                                </button>
                            </div>
                        </form>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock content %}

{% block route_script %}
    <script>
        const loginForm = document.getElementById("form-field");
        if (loginForm) {
            loginForm.addEventListener("submit", function() {
                document.getElementById("submitform").disabled = true;
            });
        }
    </script>
{% endblock route_script %}
