{% extends 'base.j2' %}
{% from 'components/icon.j2' import icon as ui_icon %}

{% block title %}Alerta{% endblock title %}
{% block body_class %}system-alert-shell{% endblock body_class %}

{% block content %}

    <div id="divContent" class="system-alert-page">
        <section class="system-alert-card" role="alert" aria-labelledby="system-alert-title">
            <div class="system-alert-heading">
                <span class="system-alert-icon">
                    {{ ui_icon('svg/lock.svg', class_name='ui-icon-md') }}
                </span>
                <div>
                    <p class="system-alert-kicker">{{ alert_type | safe }}</p>
                    <h1 id="system-alert-title" class="alert-message">{{ alert_msge | safe }}</h1>
                </div>
            </div>
            <div class="system-alert-details">
                <p class="alert-more">{{ alert_more | safe }}</p>
            </div>
            <div class="system-alert-actions">
                <a class="system-alert-action" href="{{ url_return }}">
                    <span>Voltar</span>
                </a>
            </div>
        </section>
    </div>

{% endblock content %}
