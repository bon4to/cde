            {% from 'components/icon.j2' import icon as ui_icon %}
            {% macro nav_link(endpoint, label, page_id=None) %}
                {% if page_id and paid_feature_locked(page_id) %}
                    <span class="dropdown-disabled" aria-disabled="true">
                        <span>{{ label }}</span>
                    </span>
                {% else %}
                    <a href="{{ url_for(endpoint) }}">{{ label }}</a>
                {% endif %}
            {% endmacro %}
            {% macro submenu_title(endpoint, label, page_id=None) %}
                {% if page_id and paid_feature_locked(page_id) %}
                    <span class="submenu-title dropdown-disabled" aria-disabled="true">
                        <div class="split-h" style="align-items: center;">
                            <span>{{ label }}</span>
                        </div>
                    </span>
                {% else %}
                    <a class="submenu-title" href="{{ url_for(endpoint) }}">
                        <div class="split-h" style="align-items: center;">
                            <span>{{ label }}</span>
                            {{ ui_icon('svg/chevron-right.svg', class_name='chevron chevron-submenu ui-icon-sm') }}
                        </div>
                    </a>
                {% endif %}
            {% endmacro %}
            <nav class="navigation-bar" aria-label="Navegação principal">
                <div class="navigation-brand" onclick="window.location.href='{{ url_for('home') }}';">
                    <img class="svg" src="{{ url_for('static', filename='img/cde-logo-w.png') }}" alt="CDE">
                </div>
                {% if 'user_grant' in session %}
                    <button class="navigation-toggle" type="button" aria-expanded="false" aria-controls="navigation-menu">
                        <span class="navigation-toggle-label">Menu</span>
                        <span class="navigation-toggle-icon" aria-hidden="true"></span>
                    </button>
                    <div class="navigation-divider">
                        <hr class="vert" style="width: 0;">
                    </div>
                    <div class="split-h navigation-menu" id="navigation-menu">
                        <div class="navigation-sections">
                            <div class="dropdown">
                                <button class="dropbtn" onclick="window.location.href='{{ url_for('home_logi') }}';">
                                    <span class="hyperlink">LOGÍSTICA</span>
                                    {{ ui_icon('svg/chevron-down.svg', class_name='chevron ui-icon-sm') }}
                                </button>
                                <div class="dropdown-content">
                                    <div class="submenu">
                                        {{ submenu_title('mov', 'MOV002 | MOVIMENTAR') }}
                                        <div class="submenu-content">
                                            <a href="{{ url_for('mov') }}">MOVIMENTAR</a>
                                            <a href="{{ url_for('historico') }}">HISTÓRICO</a>
                                        </div>
                                    </div>
                                    <div class="submenu">
                                        {{ submenu_title('estoque', 'MOV004 | ESTOQUE') }}
                                        <div class="submenu-content">
                                            <a href="{{ url_for('estoque') }}">AGRUPADO</a>
                                            <a href="{{ url_for('estoque_enderecado') }}">ENDEREÇADO</a>
                                            <a href="{{ url_for('inv_report') }}">RELATÓRIO</a>
                                            <a href="{{ url_for('estoque_preset') }}">PRESET</a>
                                        </div>
                                    </div>
                                    <div class="submenu">
                                        {{ submenu_title('cargas', 'MOV006 | CARGAS') }}
                                        <div class="submenu-content">
                                            <a href="{{ url_for('cargas') }}">CARGAS</a>
                                            <a href="{{ url_for('cargas_baixas') }}">BAIXAS</a>
                                            <a href="{{ url_for('carga_incomp') }}">INCOMPLETAS</a>
                                            <a href="{{ url_for('faturado') }}">FATURADAS</a>
                                            <a href="{{ url_for('carga_sep_done', id_carga=0) }}">SEPARAÇÃO</a>
                                        </div>
                                    </div>
                                    <div class="submenu">
                                        {{ submenu_title('mov_request', 'MOV007 | REQUISIÇÕES') }}
                                        <div class="submenu-content">
                                            <a href="{{ url_for('mov_request') }}">REQUISIÇÕES</a>
                                            <a href="{{ url_for('req_sep_done', id_req=0) }}">SEPARAÇÃO</a>
                                        </div>
                                    </div>
                                    <span class="dropdown-disabled dropdown-coming-soon" aria-disabled="true">
                                        <span>MOV008 | MAPA ESTOQUE</span>
                                        <span class="dropdown-status-badge">EM BREVE</span>
                                    </span>
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="dropbtn" onclick="window.location.href='{{ url_for('home_prod') }}';">
                                    <span class="hyperlink">PRODUÇÃO</span>
                                    {{ ui_icon('svg/chevron-down.svg', class_name='chevron ui-icon-sm') }}
                                </button>
                                <div class="dropdown-content">
                                    <div class="submenu">
                                        {{ submenu_title('producao', 'PRC010 | PROCESSAMENTO', 'PRC010') }}
                                        <div class="submenu-content">
                                            {{ nav_link('producao', 'PROGRAMAÇÃO', 'PRC010') }}
                                            {{ nav_link('calendar_producao', 'CALENDÁRIO', 'PRC010') }}
                                        </div>
                                    </div>
                                    <div class="submenu">
                                        {{ submenu_title('envase', 'ENV006 | ENVASE', 'ENV006') }}
                                        <div class="submenu-content">
                                            {{ nav_link('envase', 'PROGRAMAÇÃO', 'ENV006') }}
                                            {{ nav_link('calendar_envase', 'CALENDÁRIO', 'ENV006') }}
                                        </div>
                                    </div>
                                    <a href="{{ url_for('produtos') }}">ITE005 | PRODUTOS</a>
                                </div>
                            </div>
                            <div class="dropdown">
                                <button class="dropbtn">
                                    <span>OUTROS</span>
                                    {{ ui_icon('svg/chevron-down.svg', class_name='chevron ui-icon-sm') }}
                                </button>
                                <div class="dropdown-content">
                                    <a href="{{ url_for('etiqueta') }}">OUT014 | ETIQUETA</a>
                                    <a href="{{ url_for('rotulo') }}">OUT015 | RÓTULO</a>
                                    <a href="{{ url_for('supply_losses') }}">OUT016 | PERDAS</a>
                                </div>
                            </div>
                        </div>
                        <div class="flex-h navigation-actions">
                            <div class="dropdown">
                                <button class="dropbtn" style="cursor: pointer;" onclick="window.location.href='{{ url_for('cde_notifications') }}';">
                                    {{ ui_icon('svg/bell.svg', 'Notificações', 'navigation-notification-icon ui-icon-sm', 'svg-notification') }}
                                </button>
                                <div class="dropdown-content" id="notifications-container" style="right: 0; left: unset;">
                                    <!-- notifications will be automatically added here -->
                                </div>
                            </div>
                            <div class="dropdown" id="system-menu">
                                <button class="dropbtn">
                                    <span>SISTEMA</span>
                                    {{ ui_icon('svg/chevron-down.svg', class_name='chevron ui-icon-sm') }}
                                </button>
                                <div class="dropdown-content" style="right: 0; left:unset">
                                    <div class="submenu">
                                        <a class="submenu-title" href="{{ url_for('cde_cfg') }}">
                                            <div class="split-h" style="align-items: center;">
                                                <span>AJUSTES</span>
                                                {{ ui_icon('svg/chevron-right.svg', class_name='chevron chevron-submenu ui-icon-sm') }}
                                            </div>
                                        </a>
                                        <div class="submenu-content" style="left: unset; right: 100%; border-left: unset; border-right: 6px solid var(--dark-or-white);">
                                            {% if session['user_grant'] <= 2 %}
                                                <a href="{{ url_for('permissions') }}">CDE018 | CONTRATOS</a>
                                                <a href="{{ url_for('admin_migrations') }}">DEV000 | MIGRATIONS</a>
                                            {% endif %}
                                            <a href="{{ url_for('api') }}">DEV000 | DATABASE</a>
                                            <a href="{{ url_for('cde_query_list') }}">DEV000 | QUERIES</a>
                                            <a href="{{ url_for('users') }}">CDE016 | USUÁRIOS</a>
                                        </div>
                                    </div>
                                    <button class="dropdown-menu-action" type="button" onclick="toggleTheme(); dismissDropdown(this)">
                                        <span>MODO ESCURO</span>
                                        <span id="toggle-theme" class="theme-switch" aria-hidden="true"></span>
                                    </button>
                                    <a href="{{ url_for('about') }}">AJUDA</a>
                                </div>
                            </div>
                            <div class="dropdown user-menu" id="user-menu">
                                <button class="dropbtn user-params-button" type="button" aria-label="Menu do usuário">
                                    <span class="id-page white-filled user-unit">{{ app_unit }}</span>
                                    <span class="user-button">{{ session.get('user_initials', '') }}</span>
                                    {{ ui_icon('svg/chevron-down.svg', class_name='chevron ui-icon-sm') }}
                                </button>
                                <div class="dropdown-content user-menu-content">
                                    <a href="{{ url_for('cde_profile') }}">PERFIL</a>
                                    <a class="logout-link" href="{{ url_for('logout') }}">SAIR</a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </nav>
